+def _resize_valid_mask(
+    mask: NDArray[np.bool_], output_shape: Tuple[int, int], order: int
+) -> NDArray[np.bool_]:
+    """Require valid input at every contributing OpenCV resize kernel tap.
+
+    Linear/cubic resize samples at half-pixel source coordinates, unlike
+    INTER_NEAREST. Resizing an eroded mask with nearest-neighbor interpolation
+    can therefore accept coordinates that include an invalid source vertex.
+    Check the separable kernel at the same source positions as cv2.resize,
+    clamping each tap to the border. At integer positions only the center tap
+    contributes; this also preserves the mask for an unchanged output size.
+    """
+    mask = np.asarray(mask, dtype=bool)
+    h, w = mask.shape
+    new_h, new_w = output_shape
+    if output_shape == mask.shape:
+        # resize copies identity transforms without a floating-point inverse map.
+        return mask.copy()
+    if order == 0:
+        return cv2.resize(
+            mask.astype(np.uint8), (new_w, new_h), interpolation=cv2.INTER_NEAREST
+        ).astype(bool)
+    if order != 3 and h == 2 * new_h and w == 2 * new_w:
+        # OpenCV redirects exactly 2x linear downsampling to its area kernel.
+        # Keep integer indexing even above float32's half-integer precision.
+        return (
+            mask[::2, ::2] & mask[1::2, ::2]
+            & mask[::2, 1::2] & mask[1::2, 1::2]
+        )
+
+    # OpenCV computes the inverse map in double precision, then casts to float
+    # before choosing the base index and interpolation coefficients.
+    rows = ((np.arange(new_h) + 0.5) * (1.0 / (new_h / h)) - 0.5).astype(np.float32)
+    cols = ((np.arange(new_w) + 0.5) * (1.0 / (new_w / w)) - 0.5).astype(np.float32)
+    row_base = np.floor(rows).astype(np.intp)
+    col_base = np.floor(cols).astype(np.intp)
+    row_fractional = rows != row_base
+    col_fractional = cols != col_base
+    offsets = (-1, 0, 1, 2) if order == 3 else (0, 1)
+
+    # Check horizontal and vertical support separately to avoid materializing
+    # all 4/16 input taps for every output point at once.
+    horizontal_valid = np.ones((h, new_w), dtype=bool)
+    for offset in offsets:
+        source_cols = np.clip(col_base + offset, 0, w - 1)
+        tap_valid = mask[:, source_cols]
+        if offset != 0:
+            tap_valid = tap_valid | ~col_fractional[None, :]
+        horizontal_valid &= tap_valid
+
+    valid = np.ones((new_h, new_w), dtype=bool)
+    for offset in offsets:
+        source_rows = np.clip(row_base + offset, 0, h - 1)
+        tap_valid = horizontal_valid[source_rows, :]
+        if offset != 0:
+            tap_valid = tap_valid | ~row_fractional[:, None]
+        valid &= tap_valid
+    return valid
+
